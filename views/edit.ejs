<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <h2>Id : <%= post.id %></h2>
  <h2>UserName : <%= post.userName %></h2>
  <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
    <textarea rows="10" name="content" cols="40"> <%= post.content %> </textarea><br>
    <button>Submit</button>
  </form>
</body>
</html>